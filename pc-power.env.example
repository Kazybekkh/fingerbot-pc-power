# Copy to pc-power.env and chmod 600.
PC_HOST=100.64.0.2                  # the PC's Tailscale IP
FINGERBOT_MAC=AA:BB:CC:DD:EE:FF     # fingerbot Bluetooth address
API_TOKEN=change-me                 # e.g. `openssl rand -hex 32`
PORT=8741
# Optional:
# PRESS_LOG=/home/pi/fingerbot-pc-power/press.log
# TUYA_HOLD_SECONDS=3               # how long a Wake press holds the button
# TUYA_DOWN_PERCENT=100             # how far the arm pushes
# WATCH_SECONDS=180                 # how long to watch for the PC after a press
